<!-- 로컬 개발용 설정.
     이미지 기본값은 컨테이너 내부 loopback에만 listen해서 host 포트 매핑이 닿지 않는다.
     컨테이너 안에서는 모든 인터페이스를 열고, host 노출은 compose의 127.0.0.1 바인딩으로 제한한다. -->
<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>
    <!-- 이미지 기본값에 기대지 않고 명시한다 (ADR 0018). query 계정이 system.query_log 등으로
         다른 tenant의 쿼리 내용을 보지 못하게 한다. production 템플릿에도 같은 값을 둔다. -->
    <access_control_improvements>
        <select_from_system_db_requires_grant>true</select_from_system_db_requires_grant>
        <select_from_information_schema_requires_grant>true</select_from_information_schema_requires_grant>
    </access_control_improvements>
    <!-- lite 프로필 메모리 예산. 기본값은 VM 메모리의 90%까지 쓰고 mark cache만 5GiB라,
         Docker VM을 다른 stack과 나눠 쓰면 커널 OOM kill(exit 137)이 반복된다.
         서버 상한을 두면 초과 시 쿼리 하나가 MEMORY_LIMIT_EXCEEDED로 실패할 뿐 서버는 살아 있다. -->
    <max_server_memory_usage>1500000000</max_server_memory_usage>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
</clickhouse>

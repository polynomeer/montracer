<!-- 조회 값 마스킹 (D04 §10, ADR 0032). production 템플릿에도 같은 규칙을 둔다.
     ClickHouse는 서버 측 query parameter({name:Type})도 값을 끼운 query 문자열로 query_log에 남긴다
     (String은 '값', 그 밖의 type은 _CAST('값', 'Type')). 그래서 문자열 literal을 모두 '?'로 바꾼다.
     숫자(시각·limit·step)와 SQL 구조는 진단을 위해 남는다. 식별자는 backtick이라 영향이 없다.
     규칙은 query_log·query_thread_log·text_log·processes·서버 로그에 저장되기 전과 client로 보내는 로그에 적용된다. -->
<clickhouse>
    <query_masking_rules>
        <rule>
            <name>montracer string literals</name>
            <regexp>'(?:[^'\\]|\\.)*'</regexp>
            <replace>'?'</replace>
        </rule>
    </query_masking_rules>
</clickhouse>

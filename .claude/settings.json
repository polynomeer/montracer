{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(python3 scripts/docs/convert_specs.py)",
      "Bash(make doctor)",
      "Bash(make test:*)",
      "Bash(make smoke)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(make demo-reset:*)"
    ]
  }
}

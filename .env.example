# 로컬 개발 전용 가짜 값. 실제 credential을 넣지 않는다 (CI가 secret pattern을 검사한다).
# make bootstrap 이 .env 로 복사한다.

MONTRACER_ENV=local

# PostgreSQL (제어 DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=montracer
POSTGRES_USER=montracer_app
POSTGRES_PASSWORD=local-dev-only

# Kafka
KAFKA_BROKERS=localhost:9092

# ClickHouse
CLICKHOUSE_HTTP_URL=http://localhost:8123
CLICKHOUSE_USER=montracer_app
CLICKHOUSE_PASSWORD=local-dev-only

# OTLP ingress
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

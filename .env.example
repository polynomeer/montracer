# 로컬 개발 전용 가짜 값. 실제 credential을 넣지 않는다 (CI가 secret pattern을 검사한다).
# make bootstrap 이 .env 로 복사한다. 포트는 기본 포트와의 충돌을 피해 1xxxx 대역을 쓴다.

MONTRACER_ENV=local

# PostgreSQL (제어 DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=montracer
# 애플리케이션 role: NOSUPERUSER·NOBYPASSRLS (D02 §11)
POSTGRES_USER=montracer_app
POSTGRES_PASSWORD=local-dev-only
# 소유자·migration 전용
POSTGRES_ADMIN_USER=montracer_admin
POSTGRES_ADMIN_PASSWORD=local-dev-only-admin

# Kafka
KAFKA_PORT=19092
KAFKA_BROKERS=localhost:19092

# ClickHouse
CLICKHOUSE_DB=montracer
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_USER=montracer_app
CLICKHOUSE_PASSWORD=local-dev-only

# OTel Collector (OTLP 수신)
OTLP_GRPC_PORT=14317
OTLP_HTTP_PORT=14318
OTELCOL_HEALTH_PORT=13133
